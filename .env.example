# ============================================================
# HealthBridge Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/healthbridge

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Storage ──────────────────────────────────────────────────
# Strategy: local | s3
STORAGE_STRATEGY=local
STORAGE_LOCAL_PATH=./uploads

# S3 / MinIO (used when STORAGE_STRATEGY=s3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=healthbridge-documents
S3_REGION=ap-south-1

# ── AI Provider ───────────────────────────────────────────────
# Strategy: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_64_CHARS_MIN
BCRYPT_ROUNDS=12
